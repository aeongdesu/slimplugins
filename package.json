{
	"name": "@example/valenced-plugins",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "valenced-plugin build",
		"build:dev": "valenced-plugin build --dev",
		"generate-index": "valenced-plugin generate-index",
		"plan-releases": "valenced-plugin plan-releases --plugins-dir plugins",
		"serve": "valenced-plugin serve",
		"devtools": "pnpm --filter revenge-devtools-server start",
		"lint": "biome check",
		"lint:types": "tsc -b plugins/*/tsconfig.json && tsc -p server --noEmit"
	},
	"dependencies": {
		"@react-native/metro-config": "0.86.0",
		"@revenge-mod/devtools-client": "^1.4.0",
		"@revenge-mod/devtools-shared": "^1.3.0",
		"@valenced/plugin-cli": "git+https://github.com/Valenced/valenced-plugin-cli.git",
		"@valenced/types": "https://codeload.github.com/Valenced/valenced-types/tar.gz/refs/heads/main"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"react-native": "0.86.0",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"@react-native/community-cli-plugin": "npm:dry-uninstall",
		"@react-native/codegen": "npm:dry-uninstall",
		"babel-jest": "npm:dry-uninstall",
		"babel-plugin-syntax-hermes-parser": "npm:dry-uninstall",
		"hermes-compiler": "npm:dry-uninstall",
		"jsc-android": "npm:dry-uninstall",
		"react-devtools-core": "npm:dry-uninstall",
		"recyclerlistview": "npm:dry-uninstall",
		"react-native-gesture-handler": "npm:dry-uninstall",
		"react-native-screens": "npm:dry-uninstall"
	},
	"trustedDependencies": [
		"@valenced/plugin-cli",
		"@swc/core"
	]
}
